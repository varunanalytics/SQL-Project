1. Retrieve all products under the "Clothing" category
SELECT * 
FROM products
WHERE category = 'Clothing';

2. Find the top 5 most expensive products
SELECT * 
FROM products
ORDER BY price DESC
LIMIT 5; -- (Use TOP 5 if running on SQL Server)

3. List all orders placed by a specific user (e.g., user_id = 101)
SELECT * 
FROM orders
WHERE user_id = 101;

4. Calculate the total sales (total amount) for each user
SELECT 
    user_id, 
    SUM(total_amount) AS total_sales
FROM orders
GROUP BY user_id;

5. Find the most popular product based on the number of times it was ordered
SELECT 
    p.product_id, 
    p.name, 
    SUM(oi.quantity) AS total_quantity_sold
FROM order_items oi
JOIN products p ON oi.product_id = p.product_id
GROUP BY p.product_id, p.name
ORDER BY total_quantity_sold DESC
LIMIT 1;

6. Get the list of products that have low stock (less than 10 units available)
SELECT * 
FROM products
WHERE stock_quantity < 10;

7. Find the total revenue generated for each product
SELECT 
    p.product_id, 
    p.name, 
    SUM(oi.quantity * p.price) AS total_revenue
FROM order_items oi
JOIN products p ON oi.product_id = p.product_id
GROUP BY p.product_id, p.name;

8. Identify users who haven't placed any orders
SELECT 
    u.user_id, 
    u.username
FROM users u
LEFT JOIN orders o ON u.user_id = o.user_id
WHERE o.order_id IS NULL;

9. Find the average order value (total amount) for all orders
SELECT 
    AVG(total_amount) AS average_order_value
FROM orders;

10. List all products ordered by a specific user, including their order details (user_id = 102)
SELECT 
    p.name, 
    oi.quantity, 
    (oi.quantity * p.price) AS total_price
FROM order_items oi
JOIN products p ON oi.product_id = p.product_id
JOIN orders o ON oi.order_id = o.order_id
WHERE o.user_id = 102;

11. Find the users who have spent more than 1000 units on the platform
SELECT 
    user_id, 
    SUM(total_amount) AS total_spent
FROM orders
GROUP BY user_id
HAVING SUM(total_amount) > 1000;

12. List the orders along with the total items purchased in each order
SELECT 
    o.order_id, 
    COUNT(oi.order_item_id) AS total_items
FROM orders o
JOIN order_items oi ON o.order_id = oi.order_id
GROUP BY o.order_id;
